{
  "name": "nerdyap-language",
  "icon": "nerd_icon.png",
  "displayName": "NerdyYap",
  "description": "Syntax highlighting and language support for the NerdyYap esoteric programming language.",
  "version": "0.0.4",
  "publisher": "blz542",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": ["Programming Languages"],
  "repository": {
    "type": "git",
    "url": "https://github.com/blz542/NerdyYap.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "nerdyap",
        "aliases": ["NerdyYap", "nerdyap"],
        "extensions": [".nerd"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nerdyap",
        "scopeName": "source.nerd",
        "path": "./nerd.tmLanguage.json"
      }
    ]
  }
}
